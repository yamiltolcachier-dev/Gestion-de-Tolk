rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data, userId, orderId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'cliente',
          'articulo',
          'precioVenta',
          'sena',
          'precioCosto',
          'estado',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'cliente',
          'articulo',
          'numero',
          'color',
          'proveedor',
          'precioVenta',
          'sena',
          'precioCosto',
          'estado',
          'notas',
          'mesPedido',
          'fechaCreacion',
          'fechaActualizacion',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == orderId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.cliente is string
        && data.cliente.size() >= 1
        && data.cliente.size() <= 150
        && data.articulo is string
        && data.articulo.size() >= 1
        && data.articulo.size() <= 200
        && (!('numero' in data) || (data.numero is string && data.numero.size() <= 60))
        && (!('color' in data) || (data.color is string && data.color.size() <= 60))
        && (!('proveedor' in data) || (data.proveedor is string && data.proveedor.size() <= 120))
        && data.precioVenta is number
        && data.precioVenta >= 0
        && data.precioVenta <= 1000000000
        && data.sena is number
        && data.sena >= 0
        && data.sena <= 1000000000
        && data.precioCosto is number
        && data.precioCosto >= 0
        && data.precioCosto <= 1000000000
        && data.estado in [
          'Pendiente de pedir',
          'Pedido al proveedor',
          'Listo para entregar',
          'Entregado'
        ]
        && (!('notas' in data) || (data.notas is string && data.notas.size() <= 500))
        && (!('mesPedido' in data) || (data.mesPedido is string && data.mesPedido.size() <= 20))
        && (!('fechaCreacion' in data) || (data.fechaCreacion is string && data.fechaCreacion.size() <= 40))
        && (!('fechaActualizacion' in data) || (data.fechaActualizacion is string && data.fechaActualizacion.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;

      match /orders/{orderId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(orderId)
          && existing().ownerId == request.auth.uid;

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(orderId)
          && isValidOrder(incoming(), userId, orderId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(orderId)
          && isValidOrder(incoming(), userId, orderId)
          && existing().ownerId == request.auth.uid
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['estado', 'fechaActualizacion', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['sena', 'fechaActualizacion', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly([
              'cliente',
              'articulo',
              'numero',
              'color',
              'proveedor',
              'precioVenta',
              'sena',
              'precioCosto',
              'estado',
              'notas',
              'mesPedido',
              'fechaCreacion',
              'fechaActualizacion',
              'updatedAt'
            ])
          );

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(orderId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
